<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:id="@+id/hero_icon_container"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_wizard_hero_circle">

            <ImageView
                android:id="@+id/iv_hero_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                app:tint="@color/md_theme_primary"
                tools:ignore="ContentDescription"
                tools:srcCompat="@drawable/ic_notifications_pref_24dp" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_category_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_wizard_pill"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="@color/md_theme_onPrimaryContainer"
            android:textStyle="bold"
            tools:text="Izin Inti" />

        <TextView
            android:id="@+id/tv_step_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
            android:textColor="@color/card_title_text"
            android:textStyle="bold"
            tools:text="Notifikasi Real-Time" />

        <TextView
            android:id="@+id/tv_step_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/card_subtitle_text"
            tools:text="Pertahankan Battery Lab aktif untuk pemantauan langsung dan perhitungan kapasitas." />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_status_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/md_theme_surfaceVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/iv_status_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    tools:ignore="ContentDescription"
                    tools:srcCompat="@drawable/ic_wizard_schedule_24"
                    tools:tint="@color/battery_info_voltage_warning" />

                <TextView
                    android:id="@+id/tv_status_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textColor="@color/card_title_text"
                    android:textStyle="bold"
                    tools:text="Memerlukan Izin" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/md_theme_surfaceVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:id="@+id/row_point_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_point_1"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="2dp"
                        app:srcCompat="@drawable/ic_check_circle_24"
                        app:tint="@color/md_theme_primary"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/tv_point_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/card_title_text"
                        tools:text="Pantauan arus pengisian, tegangan, dan suhu baterai." />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/row_point_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_point_2"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="2dp"
                        app:srcCompat="@drawable/ic_check_circle_24"
                        app:tint="@color/md_theme_primary"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/tv_point_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/card_title_text"
                        tools:text="Menjaga akurasi perhitungan kapasitas tersisa." />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/row_point_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_point_3"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="2dp"
                        app:srcCompat="@drawable/ic_check_circle_24"
                        app:tint="@color/md_theme_primary"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/tv_point_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/card_title_text"
                        tools:text="Peringatan instan suhu dan pengisian penuh." />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_oem_tip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/charging_notice_bg"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/charging_notice_stroke"
                    app:strokeWidth="1dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            app:srcCompat="@drawable/ic_instruction_not_supported_24dp"
                            app:tint="@color/charging_notice_icon"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/tv_oem_tip"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/charging_notice_text"
                            tools:text="Di Xiaomi / HyperOS, pilih Tidak ada pembatasan." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_step_action"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            app:cornerRadius="16dp"
            app:iconGravity="textStart"
            tools:text="Izinkan Notifikasi" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
