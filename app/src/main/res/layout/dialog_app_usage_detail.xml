<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="22dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <!-- Header: App Icon (Untinted!) + App Name + Package Name + Severity Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgDialogAppIcon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                app:tint="@null"
                tools:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDialogAppName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Instagram" />

                <TextView
                    android:id="@+id/tvDialogPackageName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="middle"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    tools:text="com.instagram.android" />

                <TextView
                    android:id="@+id/tvDialogSeverityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/idle_status_badge_bg"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="Hemat" />
            </LinearLayout>
        </LinearLayout>

        <!-- Primary Metrics Grid Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvDialogMetricDrain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Konsumsi Baterai: 1.4% (~70 mAh)" />

                <TextView
                    android:id="@+id/tvDialogMetricShare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12.5sp"
                    tools:text="Porsi Antar Aplikasi: 18.2%" />

                <TextView
                    android:id="@+id/tvDialogMetricForeground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12.5sp"
                    tools:text="Layar Aktif (Foreground): 24m 10d" />

                <TextView
                    android:id="@+id/tvDialogMetricBackground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12.5sp"
                    tools:text="Servis Latar (FGS): 2m 05d" />

                <TextView
                    android:id="@+id/tvDialogMetricRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12.5sp"
                    tools:text="Rata-rata Laju Kuras: 165 mA/jam (3.3%/jam)" />

                <TextView
                    android:id="@+id/tvDialogMetricEnergy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12.5sp"
                    tools:text="Energi Terpakai: 0.27 Wh · 4x dibuka" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recommendation Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tvDialogRecommendation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:padding="12dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12.5sp"
                tools:text="Konsumsi daya aplikasi ini masih dalam batas wajar sesuai durasi pemakaian layar." />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
