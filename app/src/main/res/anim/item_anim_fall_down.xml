<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/m3_emphasized_decelerate">
    <translate
        android:duration="260"
        android:fromYDelta="6%p"
        android:toYDelta="0" />
    <scale
        android:duration="260"
        android:fromXScale="0.965"
        android:fromYScale="0.965"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1.0"
        android:toYScale="1.0" />
    <alpha
        android:duration="200"
        android:fromAlpha="0.0"
        android:toAlpha="1.0" />
</set>
